.celebration {
  position: fixed; z-index: 900; inset: 0; display: flex; box-sizing: border-box;
  align-items: center; justify-content: center; padding: 22rpx 36rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom)); background: rgba(16,36,26,.69);
}
.celebration-card {
  display: flex; flex-direction: column; overflow: hidden; width: 100%; max-width: 640rpx;
  max-height: 100%; background: #fffdf5; border-radius: 26rpx;
  box-shadow: 0 20rpx 65rpx rgba(10,29,18,.3); animation: card-arrives .28s ease-out both;
}
.stage {
  position: relative; flex: none; overflow: hidden; height: 247rpx; max-height: 31vh;
  border-bottom: 3rpx solid #dab875; background: radial-gradient(ellipse at 50% 42%,#3b6b4e 0%,#244f3a 47%,#173f31 90%);
}
.medal-halo {
  position: absolute; width: 156rpx; height: 156rpx; top: -11rpx; left: 50%; transform: translateX(-50%);
  border: 1rpx solid rgba(237,209,142,.23); border-radius: 50%;
  box-shadow: 0 0 0 10rpx rgba(243,224,159,.04),0 0 0 27rpx rgba(243,224,159,.035);
}
.poppers { position: absolute; inset: 0; width: 100%; height: 82%; }
.celebration-medal {
  position: absolute; top: -7%; left: 50%; width: 158rpx; height: 81%;
  transform: translateX(-50%) rotate(-4deg); transform-origin: 50% 0; animation: medal-arrives .9s ease-out both;
}
.celebration-title {
  position: absolute; bottom: 16rpx; right: 10rpx; left: 10rpx; color: #fff1c9; text-align: center;
  font-family: "Songti SC","Noto Serif CJK SC",serif; font-size: 40rpx; font-weight: 700; line-height: 1.3;
}
.confetti-field { position: absolute; inset: 0; pointer-events: none; }
.confetti {
  position: absolute; top: 52%; box-sizing: border-box; opacity: 0;
  animation-name: salute; animation-timing-function: cubic-bezier(.22,.56,.52,.94); animation-fill-mode: both;
}
.strip { width: 7rpx; height: 16rpx; border-radius: 1rpx; background: currentColor; }
.dot { width: 6rpx; height: 6rpx; border-radius: 50%; background: currentColor; }
.curl { width: 15rpx; height: 11rpx; border-left: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; border-radius: 0 0 0 70%; }
.celebration-list { box-sizing: border-box; flex: 0 1 auto; min-height: 0; max-height: 42vh; }
.celebration-row {
  display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; gap: 16rpx;
  min-height: 105rpx; margin: 0 26rpx; padding: 11rpx 0; color: #1e422e;
}
.celebration-row + .celebration-row { border-top: 1rpx solid #e2e4d5; }
.row-copy { flex: 1; min-width: 0; }
.row-name, .row-note { display: block; }
.row-name { font-size: 29rpx; line-height: 1.4; font-weight: 650; }
.row-note { margin-top: 3rpx; font-size: 23rpx; color: #63705d; line-height: 1.4; }
.row-value { max-width: 45%; color: #765821; text-align: right; font-size: 28rpx; line-height: 1.35; font-weight: 650; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.celebration-footer { flex: none; padding: 15rpx 24rpx 22rpx; border-top: 1rpx solid #e4e5d6; }
.celebration-dismiss {
  display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 80rpx;
  margin: 0; border: 0; padding: 14rpx; border-radius: 13rpx; background: #24533d; color: #fff8e4;
  font: inherit; font-size: 28rpx; line-height: 1.4; font-weight: 600;
}
.celebration-dismiss::after { border: 0; }
.dismiss-pressed { background: #183e2c; }
@keyframes card-arrives {
  from { opacity: .3; transform: translateY(12rpx) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes medal-arrives {
  0% { opacity: .2; transform: translate(-50%,-35%) rotate(-20deg); }
  50% { opacity: 1; transform: translate(-50%,2%) rotate(7deg); }
  75% { transform: translate(-50%,0) rotate(-7deg); }
  100% { transform: translate(-50%,0) rotate(-4deg); }
}
@keyframes salute {
  0% { opacity: 0; transform: translate(0,0) scale(.45); }
  8% { opacity: 1; }
  53% { opacity: 1; transform: translate(var(--dx),var(--dy)) rotate(var(--spin)); }
  100% { opacity: 0; transform: translate(var(--end-x),17rpx) rotate(var(--spin)) scale(.65); }
}
@media (prefers-reduced-motion: reduce) {
  .confetti, .celebration-medal, .celebration-card { animation: none; }
}
