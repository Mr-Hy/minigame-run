.board { padding: 28rpx 26rpx 56rpx; }
.tabs { display: flex; gap: 6rpx; margin-bottom: 12rpx; padding: 6rpx; background: #e6eade; border-radius: 18rpx; }
.tab { flex: 1; min-width: 0; margin: 0; padding: 0; border-radius: 13rpx; background: transparent; color: #375645; font-size: 29rpx; line-height: 76rpx; }
.tab.selected { background: #204d3c; color: #fffdf5; font-weight: 650; }
.periods { display: flex; border-bottom: 1rpx solid #d9dfd1; margin-bottom: 18rpx; }
.period { position: relative; flex: 1; min-width: 0; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #526958; font-size: 28rpx; line-height: 78rpx; }
.period.current { color: #204d3c; font-weight: 650; }
.period.current::before { content: ''; position: absolute; left: 50%; bottom: 0; width: 44rpx; height: 5rpx; border-radius: 3rpx; background: #204d3c; transform: translateX(-50%); }
.metrics { display: flex; gap: 12rpx; margin: 0 0 22rpx; }
.metric { margin: 0; padding: 0 28rpx; border-radius: 28rpx; background: transparent; color: #526958; font-size: 25rpx; line-height: 56rpx; }
.metric.current { background: #dde7d8; color: #204d3c; font-weight: 650; }
.rank-limit { align-self: center; margin-left: auto; color: #546859; font-size: 24rpx; }

/* 前三名：浅色领奖台卡片 */
.podium {
  position: relative; overflow: hidden; margin-bottom: 18rpx;
  border: 1rpx solid #e7e2cd; border-radius: 28rpx;
  background: linear-gradient(180deg, #fffdf4 0%, #f4f2e3 100%);
  box-shadow: 0 10rpx 28rpx rgba(31, 68, 55, .08);
  color: #33473b;
}
.podium-lanes {
  position: absolute; left: 50%; top: -180rpx; width: 480rpx; height: 320rpx;
  transform: translateX(-50%);
  background: radial-gradient(ellipse at center, rgba(231, 178, 74, .3), transparent 68%);
}
.podium-head { position: relative; display: flex; align-items: baseline; justify-content: space-between; gap: 14rpx; padding: 26rpx 28rpx 0; }
.podium-title { color: #1f4437; font-size: 32rpx; line-height: 1.3; font-weight: 700; letter-spacing: 3rpx; }
.podium-metric { color: #97a288; font-size: 22rpx; }
.podium-scroll { position: relative; width: 100%; }
.podium-stage { display: flex; align-items: flex-end; justify-content: center; gap: 14rpx; box-sizing: border-box; padding: 48rpx 24rpx 0; }
.podium-entry { flex: 0 1 33.333%; min-width: 0; text-align: center; }
.podium-overflow { justify-content: flex-start; }
.podium-overflow .podium-entry { flex: 0 0 30%; }
.podium-classic .podium-rank-2 { order: -1; }

/* 金、银、铜三套配色，由名次类统一驱动 */
.podium-rank-1 {
  --metal: #e2ab3e; --metal-deep: #9e7015; --soft: rgba(226, 171, 62, .28);
  --step-from: #f7df9f; --step-to: #eec863;
  --portrait: #f6e8c1; --frame-size: 132rpx; --step-height: 156rpx;
}
.podium-rank-2 {
  --metal: #9fbdc9; --metal-deep: #5f8496; --soft: rgba(148, 180, 196, .3);
  --step-from: #e4eef4; --step-to: #ccdfe8;
  --portrait: #e2edf2; --frame-size: 108rpx; --step-height: 124rpx;
}
.podium-rank-3 {
  --metal: #d2956a; --metal-deep: #96603a; --soft: rgba(210, 149, 106, .3);
  --step-from: #f3ddc8; --step-to: #eac9a5;
  --portrait: #f3e2d0; --frame-size: 108rpx; --step-height: 104rpx;
}

.podium-frame {
  position: relative; width: var(--frame-size); height: var(--frame-size); margin: 0 auto 20rpx;
  border: 4rpx solid var(--metal); border-radius: 50%; background: #fff;
  box-shadow: 0 8rpx 18rpx var(--soft);
}
.podium-crown {
  position: absolute; z-index: 2; left: 50%; top: -38rpx; width: 58rpx; height: 40rpx;
  transform: translateX(-50%);
  background: linear-gradient(180deg, #ffd977, #e0a52c);
  clip-path: polygon(0 100%, 0 32%, 22% 58%, 50% 0, 78% 58%, 100% 32%, 100% 100%);
  animation: crown-bob 2.6s ease-in-out infinite;
}
@keyframes crown-bob {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-6rpx); }
}
@media (prefers-reduced-motion: reduce) { .podium-crown { animation: none; } }
.podium-portrait {
  position: absolute; inset: 5rpx; display: flex; align-items: center; justify-content: center; overflow: hidden;
  border-radius: 50%; background: var(--portrait); color: var(--metal-deep);
  font-size: 38rpx; font-weight: 700;
}
.podium-rank-1 .podium-portrait { font-size: 46rpx; }
.podium-portrait image { position: absolute; inset: 0; width: 100%; height: 100%; }
.podium-medal {
  position: absolute; z-index: 1; left: 50%; bottom: -13rpx; transform: translateX(-50%); padding: 0 14rpx;
  border: 2rpx solid var(--metal); border-radius: 999rpx; background: #fffdf6;
  color: var(--metal-deep); font-size: 18rpx; font-weight: 700; line-height: 1.7; white-space: nowrap;
}

.podium-step {
  position: relative; box-sizing: border-box; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  min-height: var(--step-height); padding: 14rpx 8rpx;
  border-radius: 18rpx 18rpx 0 0; background: linear-gradient(180deg, var(--step-from), var(--step-to));
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, .55);
}
.podium-no {
  position: absolute; right: 12rpx; bottom: 6rpx; color: rgba(255, 255, 255, .55);
  font-size: 42rpx; font-weight: 800; line-height: 1;
}
.podium-name { position: relative; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #413a26; font-size: 25rpx; font-weight: 650; }
.podium-score { position: relative; display: block; margin-top: 4rpx; color: var(--metal-deep); font-size: 22rpx; font-weight: 700; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }

.table { overflow: hidden; border: 1rpx solid #d9dfd1; border-radius: 18rpx; background: #fffef8; }
.table-head, .row { display: flex; align-items: center; gap: 16rpx; padding: 0 20rpx; }
.table-head { min-height: 68rpx; background: #edf0e6; color: #546859; font-size: 22rpx; }
.row { min-height: 100rpx; border-top: 1rpx solid #e1e6da; }
.position { flex: none; width: 58rpx; text-align: center; }
.rank { color: #5a6d5e; font-size: 29rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.subject { display: flex; align-items: center; flex: 1; min-width: 0; gap: 14rpx; }
.avatar { position: relative; flex: none; overflow: hidden; width: 58rpx; height: 58rpx; border-radius: 50%; background: #e1e8da; color: #43604a; text-align: center; font-size: 25rpx; line-height: 58rpx; }
.avatar image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; }
.score { flex: none; color: #204d3c; font-size: 28rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.state { padding: 90rpx 12rpx; text-align: center; color: #596c60; font-size: 27rpx; }
.retry { display: inline-block; width: auto; margin: 18rpx 0 0; padding: 0 24rpx; border-radius: 12rpx; background: #e6eade; color: #375645; font-size: 25rpx; line-height: 68rpx; }
.board.with-self { padding-bottom: 152rpx; padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.self-bar { position: fixed; z-index: 2; right: 24rpx; bottom: 16rpx; bottom: calc(16rpx + env(safe-area-inset-bottom)); left: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 96rpx; padding: 0 24rpx; border-radius: 18rpx; background: #204d3c; color: #fffdf5; box-shadow: 0 5rpx 16rpx rgba(25, 61, 48, .18); }
.self-position { display: flex; align-items: center; gap: 16rpx; }
.self-label { color: #dce8db; font-size: 24rpx; }
.self-rank, .self-score { font-size: 28rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
