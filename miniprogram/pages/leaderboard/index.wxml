<view class="board {{self ? 'with-self' : ''}}">
  <view class="tabs">
    <button class="tab {{scope === 'national' ? 'selected' : ''}}" data-scope="national" bindtap="switchScope">全国榜</button>
    <button class="tab {{scope === 'province' ? 'selected' : ''}}" data-scope="province" bindtap="switchScope">省份榜</button>
  </view>
  <view class="periods">
    <button class="period {{period === 'day' ? 'current' : ''}}" data-period="day" bindtap="switchPeriod">日榜</button>
    <button class="period {{period === 'week' ? 'current' : ''}}" data-period="week" bindtap="switchPeriod">周榜</button>
    <button class="period {{period === 'month' ? 'current' : ''}}" data-period="month" bindtap="switchPeriod">月榜</button>
  </view>
  <view class="metrics">
    <button class="metric {{metric === 'area' ? 'current' : ''}}" data-metric="area" bindtap="switchMetric">面积榜</button>
    <button class="metric {{metric === 'distance' ? 'current' : ''}}" data-metric="distance" bindtap="switchMetric">距离榜</button>
    <text wx:if="{{scope === 'national' && rankLimit}}" class="rank-limit">前 {{rankLimit}} 位跑者</text>
  </view>
  <view class="state" wx:if="{{error}}">
    <view>{{error}}</view>
    <button class="retry" bindtap="retry">重新加载</button>
  </view>
  <view class="podium" wx:if="{{podium.length}}">
    <view class="podium-lanes" aria-hidden="true"></view>
    <view class="podium-head">
      <text class="podium-title">本期前三</text>
      <text class="podium-metric">{{metric === 'area' ? '本期净增面积' : '本期有效距离'}}</text>
    </view>
    <scroll-view class="podium-scroll" scroll-x="{{podium.length > 3}}">
      <view class="podium-stage {{podium.length > 3 ? 'podium-overflow' : ''}} {{podium.length === 3 && podium[1].rank === 2 && podium[2].rank === 3 ? 'podium-classic' : ''}}">
        <view wx:for="{{podium}}" wx:key="id" class="podium-entry podium-rank-{{item.rank}}">
          <view class="podium-frame">
            <view wx:if="{{item.rank === 1}}" class="podium-crown" aria-hidden="true"></view>
            <view class="podium-portrait">
              <text aria-hidden="true">{{item.initial}}</text>
              <image wx:if="{{scope === 'national' && item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load="{{true}}" aria-hidden="true" />
            </view>
            <text class="podium-medal">{{item.rank === 1 ? '冠军' : (item.rank === 2 ? '亚军' : '季军')}}</text>
          </view>
          <view class="podium-step">
            <text class="podium-no" aria-hidden="true">{{item.rank}}</text>
            <text class="podium-name">{{item.name}}</text>
            <text class="podium-score">{{item.score}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <view class="table" wx:if="{{rows.length}}">
    <view class="table-head">
      <text class="position">名次</text>
      <text class="subject">{{scope === 'province' ? '省份' : '跑者'}}</text>
      <text>{{metric === 'area' ? '本期净增面积' : '本期有效距离'}}</text>
    </view>
    <view class="row" wx:for="{{rows}}" wx:key="id">
      <view class="position rank">{{item.rank}}</view>
      <view class="subject">
        <view wx:if="{{scope === 'national'}}" class="avatar">
          <text>{{item.initial}}</text>
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load="{{true}}" />
        </view>
        <text class="name">{{item.name}}</text>
      </view>
      <text class="score">{{item.score}}</text>
    </view>
  </view>
  <block wx:if="{{!podium.length && !rows.length}}">
    <view class="state" wx:if="{{loading}}">正在加载…</view>
    <view class="state" wx:elif="{{!error}}">{{metric === 'area' ? '本期暂无净增领地' : '本期暂无已结算的跑步里程'}}</view>
  </block>
  <view wx:if="{{self}}" class="self-bar">
    <view class="self-position">
      <text class="self-label">我的排名</text>
      <text class="self-rank">{{self.rank ? '第 ' + self.rank + ' 名' : (self.outside_limit ? rankLimit + ' 名以外' : '暂未上榜')}}</text>
    </view>
    <text class="self-score">{{self.score}}</text>
  </view>
</view>
