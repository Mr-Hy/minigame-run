page { background: #f7f6ef; color: #193e31; }
.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  max-width: 600px;
  margin: 0 auto;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.identity { display: flex; align-items: center; min-height: 108rpx; margin-bottom: 28rpx; }
.avatar { flex: none; display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; overflow: hidden; border: 2rpx solid #d0dacc; border-radius: 50%; background: #e5ebdf; }
.avatar { position: relative; }
.avatar-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; }
.avatar-ready { opacity: 1; }
.avatar-symbol { width: 60rpx; height: 60rpx; }
.identity-copy, .land-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.identity-copy { margin: 0 18rpx; }
.profile-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 36rpx; line-height: 1.35; font-weight: 650; }
.profile-note, .row-detail { margin-top: 6rpx; color: #607063; font-size: 23rpx; line-height: 1.45; }
.identity-action {
  flex: none; display: flex; align-items: center; justify-content: center; gap: 12rpx; width: auto; min-height: 66rpx;
  margin: 0; padding: 0 22rpx; border: 1rpx solid #cdd8c9; border-radius: 40rpx; background: transparent; color: #315241; font-size: 24rpx; line-height: 1.2;
}
.identity-action.login { border-color: #c3d3b3; background: #e3edcf; color: #234831; font-weight: 600; }
.profile-page button.identity-action, .profile-page button.quiet-button { width: auto; margin: 0; }
.chevron { display: block; flex: none; box-sizing: border-box; width: 12rpx; height: 12rpx; border: solid currentColor; border-width: 2.5rpx 2.5rpx 0 0; transform: rotate(45deg); }
.chevron.down { transform: translateY(-2rpx) rotate(135deg); }
.chevron.up { transform: translateY(2rpx) rotate(-45deg); }

.journal { position: relative; overflow: hidden; box-sizing: border-box; padding: 32rpx 32rpx 24rpx; border-radius: 28rpx; background: #174b39; color: #fcfcf1; }
.journal-pressed { background: #133f31; }
.journal-main, .journal-footer { position: relative; z-index: 1; }
.journal-title { display: block; font-size: 34rpx; font-weight: 650; line-height: 1.25; }
.mileage-label { display: block; margin-top: 24rpx; color: #dbe8ce; font-size: 23rpx; line-height: 1.3; }
.mileage { display: flex; align-items: baseline; gap: 12rpx; }
.distance { font-family: "DIN Alternate", "Avenir Next", sans-serif; font-size: 84rpx; font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; letter-spacing: -2rpx; }
.distance-unit { color: #dbe8ce; font-size: 25rpx; }
.track-window { position: absolute; top: 0; right: 0; bottom: 0; width: 49%; overflow: hidden; pointer-events: none; }
.track { position: absolute; top: -187rpx; right: -102rpx; width: 330rpx; height: 432rpx; border-radius: 180rpx; transform: rotate(32deg); border: 2rpx solid #75a079; }
.lane { position: absolute; border: 2rpx solid #75a079; border-radius: 180rpx; }
.lane-one { inset: 14rpx; } .lane-two { inset: 28rpx; } .lane-three { inset: 42rpx; } .lane-four { inset: 56rpx; }
.finish-mark { position: absolute; top: 56%; left: 0; width: 56rpx; height: 5rpx; background: #d7e996; }
.journal-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid #4e7057; }
.journal-totals { display: flex; flex: 1; min-width: 0; gap: 36rpx; }
.journal-totals > view { min-width: 0; }
.total-caption, .total-value { display: block; }
.total-caption { color: #d5e3cc; font-size: 21rpx; line-height: 1.3; }
.total-value { margin-top: 4rpx; font-size: 28rpx; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; }
.journal-link { flex: none; display: flex; align-items: center; gap: 12rpx; color: #e3efb7; font-size: 24rpx; font-weight: 550; }
.journal-arrow { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #d9eba0; color: #254735; }
.journal-arrow .chevron { width: 10rpx; height: 10rpx; margin-right: 4rpx; }
.journal.cover { padding-top: 40rpx; }
.cover .journal-title { font-size: 52rpx; }
.cover-copy { display: block; position: relative; margin-top: 14rpx; color: #dee9d8; font-size: 24rpx; line-height: 1.5; }
.cover .journal-footer { justify-content: flex-start; margin-top: 44rpx; }
.cover .track { top: -224rpx; right: -116rpx; }

.section-title { display: block; margin: 42rpx 0 18rpx; font-size: 32rpx; font-weight: 650; line-height: 1.35; }
.land-panel, .management { padding: 0 24rpx; overflow: hidden; border: 1rpx solid #dbe1d4; border-radius: 20rpx; background: #fffef9; }
.land-row, .manage-row, .test-entry {
  box-sizing: border-box; display: flex; align-items: center; gap: 20rpx; width: 100%; margin: 0; padding: 0;
  border-radius: 0; background: transparent; text-align: left; color: #224838; line-height: 1.4;
}
.land-row { min-height: 120rpx; }
.profile-page button.land-row, .profile-page button.manage-row { width: 100%; margin: 0; }
.land-row + .land-row, .manage-row + .manage-row, .nickname-form + .manage-row { border-top: 1rpx solid #e3e7dc; }
.land-row > .chevron, .test-entry > .chevron, .manage-row > .chevron { margin-right: 6rpx; color: #637467; }
.land-icon { flex: none; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 64rpx; height: 64rpx; border-radius: 18rpx; background: #e8efe0; color: #28593f; }
.land-icon image { width: 38rpx; height: 38rpx; }
.icon-reports { background: #f4ecda; color: #866a3d; }
.report-sheet { box-sizing: border-box; width: 26rpx; height: 32rpx; padding: 5rpx 3rpx; border: 2.5rpx solid currentColor; border-radius: 4rpx; }
.report-sheet > view { height: 2rpx; margin: 2rpx 0 4rpx; background: currentColor; }
.report-sheet > view:last-child { width: 65%; }
.row-title { font-size: 29rpx; font-weight: 600; }
.test-entry { min-height: 88rpx; margin-top: 16rpx; padding: 0 8rpx; justify-content: space-between; color: #627166; font-size: 24rpx; }
.row-pressed { background: #f0f3e9; }
.achievement-entry { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding: 18rpx 28rpx 18rpx 22rpx; color: #423d27; background: #fbf5e4; border: 1rpx solid #e2d8b7; border-radius: 20rpx; }
.achievement-medal { flex: none; width: 70rpx; height: 76rpx; }
.achievement-entry .row-detail { color: #71684e; }
.achievement-entry .chevron { color: #827448; }
.achievement-pressed { background: #f2ead3; }

.management { margin-bottom: 24rpx; }
.manage-row { min-height: 88rpx; justify-content: space-between; font-size: 27rpx; }
.logout { color: #8a493c; }
.nickname-form { display: block; padding: 20rpx 0; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.nickname-input { box-sizing: border-box; width: 100%; height: 80rpx; padding: 0 16rpx; border: 1rpx solid #b9c9b7; border-radius: 12rpx; font-size: 28rpx; background: #fffef9; }
.nickname-actions, .error-row { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.nickname-actions { margin-top: 16rpx; }
.quiet-button { flex: none; width: auto; margin: 0; padding: 0 16rpx; color: #315c46; background: transparent; font-size: 25rpx; line-height: 66rpx; }
.error-row { justify-content: space-between; margin: 0 0 20rpx; padding: 4rpx 16rpx; border: 1rpx solid #e7d5c9; border-radius: 12rpx; background: #fbf1e7; }
.error-row, .error-text { color: #8b4837; font-size: 24rpx; line-height: 1.5; }
.error-text { display: block; margin-top: 8rpx; }
