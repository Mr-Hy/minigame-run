page { background: #f2ede3; color: #302b25; }
.login-page { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; min-height: 100vh; overflow: hidden; padding: 48rpx 40rpx calc(54rpx + env(safe-area-inset-bottom)); }
.wash { position: absolute; border-radius: 50%; background: rgba(109,82,58,.055); filter: blur(2rpx); pointer-events: none; }
.wash-one { top: -160rpx; right: -170rpx; width: 500rpx; height: 500rpx; }
.wash-two { bottom: 80rpx; left: -220rpx; width: 460rpx; height: 460rpx; }
.login-card { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; width: 100%; max-width: 650rpx; padding: 58rpx 42rpx 46rpx; border: 1rpx solid rgba(76,65,53,.12); border-radius: 20rpx; background: rgba(255,253,248,.9); box-shadow: 0 24rpx 60rpx rgba(60,45,32,.09); }
.login-kicker { color: #8a4b42; font-family: STKaiti, KaiTi, serif; font-size: 22rpx; letter-spacing: 8rpx; }
.avatar-ring { display: flex; align-items: center; justify-content: center; width: 164rpx; height: 164rpx; margin-top: 34rpx; overflow: hidden; border: 2rpx solid rgba(177,134,92,.72); border-radius: 50%; background: #fffaf1; box-shadow: 0 15rpx 34rpx rgba(61,43,29,.13); }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; width: 146rpx; height: 146rpx; border-radius: 50%; background: linear-gradient(145deg, #463f37, #26231f); color: #fffaf1; font-family: STKaiti, KaiTi, serif; font-size: 68rpx; }
.avatar-image { width: 100%; height: 100%; }
.login-title { margin-top: 28rpx; font-family: STKaiti, KaiTi, serif; font-size: 42rpx; letter-spacing: 6rpx; }
.login-copy { margin-top: 16rpx; color: #887e72; font-size: 23rpx; line-height: 1.8; text-align: center; }
.privacy-consent { align-self: stretch; margin-top: 28rpx; color: #6d6257; font-size: 22rpx; line-height: 1.8; }
.consent-row { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; }
.consent-choice { display: flex; align-items: center; min-height: 60rpx; }
.consent-choice checkbox { margin-right: 6rpx; transform: scale(.8); }
.consent-link { padding: 10rpx 0; color: #536650; text-decoration: underline; }
.login-button { display: flex; align-self: stretch; align-items: center; justify-content: center; box-sizing: border-box; width: auto; height: 84rpx; margin-top: 20rpx; padding: 0 36rpx; overflow: hidden; border-radius: 999rpx; background: #536650; color: #fffdf7; font-size: 27rpx; letter-spacing: 2rpx; line-height: 1.2; white-space: nowrap; box-shadow: 0 12rpx 28rpx rgba(52,76,54,.18); }
.login-button-label { display: block; flex-shrink: 0; line-height: 1.2; white-space: nowrap; }
.login-button::after { border: 0; }
.login-button[disabled] { background: #7f8d7c; color: rgba(255,253,247,.82); }
.guest-button { margin-top: 16rpx; background: transparent; color: #6f665c; font-size: 22rpx; line-height: 58rpx; }
.guest-button::after { border: 0; }
.error-message { margin-top: 18rpx; color: #8a3027; font-size: 21rpx; line-height: 1.6; text-align: center; }
.privacy-note { margin-top: 26rpx; color: #9b9185; font-size: 19rpx; line-height: 1.65; text-align: center; }
