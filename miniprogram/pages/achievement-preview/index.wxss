.preview { box-sizing: border-box; max-width: 840rpx; margin: 0 auto; padding: 16rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); color: #193e2e; }
.cover { position: relative; overflow: hidden; display: flex; align-items: center; min-height: 255rpx; border-radius: 22rpx; background: linear-gradient(117deg,#173d30,#2f644a); }
.cover-copy { position: relative; z-index: 1; box-sizing: border-box; width: 65%; padding: 28rpx 0 30rpx 32rpx; }
.sample-tag { display: inline-block; padding: 3rpx 12rpx; border: 1rpx solid #99a77c; border-radius: 5rpx; color: #eee5bd; font-size: 20rpx; line-height: 1.5; letter-spacing: 2rpx; }
.title, .intro, .detail { display: block; }
.title { margin: 12rpx 0 9rpx; color: #fff5d9; font-family: "Songti SC","Noto Serif CJK SC",serif; font-size: 44rpx; font-weight: 700; line-height: 1.32; }
.intro { color: #dfebd7; font-size: 24rpx; line-height: 1.55; }
.medal { position: absolute; right: 17rpx; top: -19rpx; width: 219rpx; height: 267rpx; transform: rotate(-8deg); }
.section-heading { display: flex; align-items: center; gap: 16rpx; margin: 34rpx 3rpx 18rpx; font-size: 28rpx; font-weight: 650; }
.rule { flex: 1; height: 1rpx; background: #d7ddce; }
.choices { display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; }
.preview .choice { display: flex; align-items: center; gap: 11rpx; width: 100%; min-height: 97rpx; margin: 0; padding: 13rpx 18rpx; border: 2rpx solid #dce0d2; border-radius: 14rpx; color: #334d3b; background: #fffef8; font-size: 26rpx; font-weight: 550; line-height: 1.3; text-align: left; }
.choice::after, .play::after { border: 0; }
.preview .chosen { border-color: #477351; background: #e8efdf; color: #244b34; }
.choice-icon { width: 36rpx; height: 36rpx; flex: none; }
.indicator { box-sizing: border-box; flex: none; width: 21rpx; height: 21rpx; margin-left: auto; border-radius: 50%; border: 2rpx solid #afbba7; }
.chosen .indicator { border: 5rpx solid #477351; background: #fffef8; }
.preview .pressed { background: #e2ead9; }
.playback { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #dce0d2; border-radius: 16rpx; background: #fffef8; }
.detail { color: #536553; font-size: 25rpx; line-height: 1.6; }
.preview .play { display: flex; width: 100%; min-height: 80rpx; margin: 19rpx 0 0; padding: 12rpx 16rpx; align-items: center; justify-content: center; gap: 14rpx; box-sizing: border-box; border-radius: 12rpx; background: #24533b; color: #fff6dc; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.triangle { width: 0; height: 0; border-top: 9rpx solid transparent; border-bottom: 9rpx solid transparent; border-left: 14rpx solid #e5d8a5; }
.preview .play-pressed { background: #173d2d; }
.empty-result { display: flex; align-items: baseline; gap: 10rpx; margin-top: 18rpx; padding-top: 17rpx; border-top: 1rpx solid #e3e7d9; color: #536553; font-size: 24rpx; line-height: 1.55; }
.empty-dot { width: 11rpx; height: 11rpx; flex: none; border-radius: 50%; background: #708563; }
